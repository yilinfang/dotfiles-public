#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
	echo "keep-mac-awake is only supported on macOS." >&2
	exit 1
fi

for cmd in caffeinate lockf; do
	if ! command -v "${cmd}" >/dev/null 2>&1; then
		echo "error: ${cmd} is not installed or not in PATH" >&2
		exit 127
	fi
done

STATE_DIR="/tmp/keep-mac-awake-${UID}"
PID_FILE="${STATE_DIR}/keep-mac-awake.pid"
LOG_FILE="${STATE_DIR}/keep-mac-awake.log"
LOCK_FILE="${STATE_DIR}/keep-mac-awake.lock"

usage() {
	echo "Usage:"
	echo "  keep-mac-awake start [duration]"
	echo "  keep-mac-awake stop"
	echo "  keep-mac-awake status"
	echo
	echo "Examples:"
	echo "  keep-mac-awake start"
	echo "  keep-mac-awake start 8h"
	echo "  keep-mac-awake start 30m"
	echo "  keep-mac-awake stop"
}

initialize_state() {
	if [[ -L "${STATE_DIR}" ]]; then
		echo "Refusing to use symlinked state directory: ${STATE_DIR}"
		exit 1
	fi

	if [[ ! -d "${STATE_DIR}" ]] && ! mkdir -m 700 "${STATE_DIR}"; then
		echo "Failed to create state directory: ${STATE_DIR}"
		exit 1
	fi

	if [[ "$(stat -f %u "${STATE_DIR}")" != "${UID}" ]]; then
		echo "State directory is not owned by the current user: ${STATE_DIR}"
		exit 1
	fi

	if ! chmod 700 "${STATE_DIR}"; then
		echo "Failed to secure state directory: ${STATE_DIR}"
		exit 1
	fi
}

acquire_lock() {
	exec 9>"${LOCK_FILE}"
	if ! lockf -s 9; then
		echo "Failed to lock keep-mac-awake state."
		exit 1
	fi
}

process_fingerprint() {
	ps -p "$1" -o lstart= -o command= 2>/dev/null
}

is_running() {
	RUNNING_PID=""
	RUNNING_FINGERPRINT=""

	if [[ ! -f "${PID_FILE}" ]]; then
		return 1
	fi

	local version pid fingerprint extra current_fingerprint
	{
		IFS= read -r version || true
		IFS= read -r pid || true
		IFS= read -r fingerprint || true
		IFS= read -r extra || true
	} <"${PID_FILE}"

	if [[ "${version}" != "1" ]] ||
		! [[ "${pid}" =~ ^[1-9][0-9]*$ ]] ||
		[[ -z "${fingerprint}" ]] ||
		[[ -n "${extra}" ]]; then
		rm -f "${PID_FILE}"
		return 1
	fi

	current_fingerprint="$(process_fingerprint "${pid}")"
	if [[ -z "${current_fingerprint}" ]] ||
		[[ "${current_fingerprint}" != "${fingerprint}" ]]; then
		rm -f "${PID_FILE}"
		return 1
	fi

	RUNNING_PID="${pid}"
	RUNNING_FINGERPRINT="${fingerprint}"
	return 0
}

duration_to_seconds() {
	local duration="$1"
	local value unit multiplier maximum

	if ! [[ "${duration}" =~ ^([0-9]+)([smhd]?)$ ]]; then
		return 1
	fi

	value="${BASH_REMATCH[1]}"
	unit="${BASH_REMATCH[2]}"
	value="${value#"${value%%[!0]*}"}"
	value="${value:-0}"

	case "${unit}" in
	"" | s)
		multiplier=1
		maximum=9223372036854775807
		;;
	m)
		multiplier=60
		maximum=153722867280912930
		;;
	h)
		multiplier=3600
		maximum=2562047788015215
		;;
	d)
		multiplier=86400
		maximum=106751991167300
		;;
	esac

	# Both operands are equal-length decimals; numeric comparison could overflow.
	# shellcheck disable=SC2071
	if [[ "${value}" == "0" ]] ||
		[[ "${#value}" -gt "${#maximum}" ]] ||
		{ [[ "${#value}" -eq "${#maximum}" ]] && [[ "${value}" > "${maximum}" ]]; }; then
		return 1
	fi

	echo $((10#${value} * multiplier))
}

start_awake() {
	if is_running; then
		echo "keep-mac-awake is already running with PID ${RUNNING_PID}."
		exit 0
	fi

	local duration="${1:-}"
	local caffeinate_args=(-dimsu)

	if [[ -n "${duration}" ]]; then
		local seconds
		if ! seconds="$(duration_to_seconds "${duration}")"; then
			echo "Invalid duration: ${duration}"
			echo "Use values such as 30m, 8h, 1d, or seconds."
			exit 1
		fi

		caffeinate_args+=(-t "${seconds}")
	fi

	nohup caffeinate "${caffeinate_args[@]}" \
		>>"${LOG_FILE}" 2>&1 9>&- &

	local pid=$!
	sleep 0.2

	local fingerprint
	fingerprint="$(process_fingerprint "${pid}")"

	if [[ -n "${fingerprint}" ]]; then
		if ! printf '1\n%s\n%s\n' "${pid}" "${fingerprint}" >"${PID_FILE}"; then
			kill "${pid}" 2>/dev/null || true
			echo "Failed to record keep-mac-awake process."
			exit 1
		fi

		if [[ -n "${duration}" ]]; then
			echo "keep-mac-awake started for ${duration} with PID ${pid}."
		else
			echo "keep-mac-awake started with PID ${pid}."
		fi
	else
		rm -f "${PID_FILE}"
		echo "Failed to start keep-mac-awake. Check ${LOG_FILE}."
		exit 1
	fi
}

stop_awake() {
	if ! is_running; then
		echo "keep-mac-awake is not running."
		exit 0
	fi

	local pid
	pid="${RUNNING_PID}"

	if [[ "$(process_fingerprint "${pid}")" != "${RUNNING_FINGERPRINT}" ]]; then
		rm -f "${PID_FILE}"
		echo "keep-mac-awake is not running."
		exit 0
	fi

	if kill "${pid}" 2>/dev/null; then
		rm -f "${PID_FILE}"
		echo "keep-mac-awake stopped."
	else
		rm -f "${PID_FILE}"
		echo "keep-mac-awake exited before it could be stopped."
	fi
}

status_awake() {
	if is_running; then
		echo "keep-mac-awake is running with PID ${RUNNING_PID}."
	else
		echo "keep-mac-awake is not running."
	fi
}

case "${1:-}" in
start)
	initialize_state
	acquire_lock
	start_awake "${2:-}"
	;;
stop)
	initialize_state
	acquire_lock
	stop_awake
	;;
status)
	initialize_state
	acquire_lock
	status_awake
	;;
*)
	usage
	exit 1
	;;
esac
