# Theme
config-file = ?auto/theme.ghostty

# Fix split color
unfocused-split-opacity = 1
split-divider-color = green

# Font
# font-family = ""
# font-family = "MonoLisaCode"
# font-feature = "'calt' off, 'liga' off, 'dlig' off, 'ss01', 'ss10', 'ss11'"
# # Nerd font glyphs
# font-family = "Symbols Nerd Font Mono"
# font-size = 13
# adjust-underline-position = 2
font-family = ""
font-family = "JetBrains Mono Nerd Font"
adjust-underline-position = 2

# Window
window-padding-balance = true
window-padding-color = extend

# Fix alt+arrow
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+f=esc:f
keybind = alt+b=esc:b

# Misc
copy-on-select = clipboard
# shell-integration-features = ssh-env,ssh-terminfo

# MacOS
config-file = ?optional/macos.ghostty

# Linux
config-file = ?optional/linux.ghostty
