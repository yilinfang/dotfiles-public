# MacOS Specific Configuraions

# Font
font-family = ""
font-family = "Maple Mono NF CN"
font-style = "Light"
font-style-bold = "Medium"
font-style-italic = "Light Italic"
font-style-bold-italic = "Medium Italic"
font-feature = +calt,+cv02,+cv05,--ss03,+zero
font-size = 13
adjust-underline-position = 2

# Window
window-width = 90
window-height = 30

# Misc
macos-option-as-alt = true
quit-after-last-window-closed = true
