# MacOS Specific Configuraions

# Font
font-family = ""
font-family = "Maple Mono"
font-family = "Symbols Nerd Font Mono"
font-feature = "'calt' on, 'cv01' on, 'cv02' on, 'cv05' on, 'zero' on"
font-size = 14
adjust-underline-position = 2

# Window
window-width = 90
window-height = 30

# Misc
macos-option-as-alt = true
quit-after-last-window-closed = true
