# MacOS Specific Configuraions

# Font
font-family = ""
font-family = "Redwood Mono"
font-family = "Symbols Nerd Font Mono"
font-size = 14
font-codepoint-map = U+2E80-U+9FFF,U+F900-U+FAFF,U+FF00-U+FFEF="LXGW Neo XiHei"
adjust-underline-position = 4

# Window
window-width = 90
window-height = 30

# Misc
macos-option-as-alt = true
quit-after-last-window-closed = true
