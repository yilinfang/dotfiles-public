# MacOS Specific Configuraions

# Font
font-family = ""
font-family = "MonoLisa"
font-family = "Symbols Nerd Font Mono"
font-feature = "'calt' off, 'liga' off, 'ss02' on, 'ss03' on, 'ss07' on, 'ss08' on"
font-size = 13
adjust-underline-position = 2

# Window
window-width = 90
window-height = 30

# Misc
macos-option-as-alt = true
quit-after-last-window-closed = true
