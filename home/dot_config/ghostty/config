# Theme
config-file = ?auto/theme.ghostty

# Font
font-family = ""
font-family = "MonoLisaCode"
font-feature = "'calt' off, 'liga' off, 'dlig' off, 'ss01' on"
# CJK glyphs
config-file = fonts/cjk
# Nerd fonts glyphs
config-file = fonts/nerd-font

# Window
window-padding-balance = true
window-padding-color = extend

# Fix alt+arrow
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+f=esc:f
keybind = alt+b=esc:b

# Misc
copy-on-select = clipboard
# shell-integration-features = ssh-env,ssh-terminfo

# MacOS
config-file = ?optional/macos

# Linux
config-file = ?optional/linux
