[status]
# exclude = ["scripts"]

[diff]
# exclude = ["scripts"]
pager = "delta"

[merge]
command = "nvim"
args = [
  "-d",
  {{ printf "%q" "{{ .Destination }}" }},
  {{ printf "%q" "{{ .Source }}" }},
  {{ printf "%q" "{{ .Target }}" }}
]

[data]
{{- if env "IS_PDE" }}
work = true
{{- else }}
work = false
{{- end }}
